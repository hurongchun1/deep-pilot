# 与 AgentSeek content-builder 模板一致，使用 OpenAI 兼容接口。
AGENTSEEK_MODEL_PROVIDER=openai
AGENTSEEK_MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com/v1

# 所有实验支持 LangSmith；已有 Windows 环境变量优先，无需在此重复填写。
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deep-pilot-task6
# 如账号位于其他区域，可设置 LANGSMITH_ENDPOINT。
